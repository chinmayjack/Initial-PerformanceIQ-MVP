# Local Postgres example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/performanceiq?schema=public"

# Supabase app runtime example. Use the pooled Transaction pooler URI for Vercel:
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase migration/seed example. Use the Session pooler or direct URI locally:
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

OPENAI_API_KEY=""
OPENAI_REVIEW_MODEL="gpt-4o-mini"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
